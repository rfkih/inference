# Copy to .env, fill in real values for local dev.

# Service profile. 'prod' enables Settings.assert_prod_safe(); 'dev' is permissive.
INFERENCE_PROFILE=dev

# Shared-secret bearer token. Loopback-only deployment — this is defense in depth.
INFERENCE_AUTH_TOKEN=dev-token

# Postgres DSN. Connect as blackheart_research role per V14 — reads feature_values,
# feature_registry, model_registry, signal_definition; writes signal_history.
INFERENCE_DB_DSN=postgresql://blackheart_research:CHANGEME@127.0.0.1:5432/blackheart

# Where blackheart-train writes .pkl artifacts. Inference reads from the same path.
# Must be readable by this process — no remote URI support yet (stage A3 sidecar contract).
INFERENCE_ARTIFACT_DIR=C:/Project/blackheart-train/artifacts

# Host + port. 127.0.0.1 is mandatory in prod (loopback). The trading JVM and
# blackheart-research-orchestrator both run on the same box.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8000
